{"type":"before","callId":"call@480","startTime":244098.228,"class":"Frame","method":"evaluateExpression","params":{"expression":"(actionIndex) => {\n                    const state = { started: performance.now(), ready: null, frame: document.querySelector('[role=\"dialog\"]'),\n                        editor: document.querySelector('.mdxeditor-content'), tasks: [] };\n                    window.j60Measurement = state;\n                    state.taskObserver = new PerformanceObserver((entries) => state.tasks.push(...entries.getEntries().map(\n                        ({ startTime, duration }) => ({ startTime, duration }),\n                    )));\n                    state.taskObserver.observe({ type: 'longtask' });\n                    state.observer = new MutationObserver(() => {\n                        const editor = document.querySelector('.mdxeditor-content');\n                        if (state.ready !== null || editor?.getAttribute('contenteditable') !== 'true'\n                            || !editor.textContent.startsWith(`agent-${actionIndex}`)) return;\n                        state.ready = performance.now();\n                    });\n                    state.observer.observe(document.body, { attributes: true, childList: true, subtree: true });\n                    [...document.querySelectorAll('[aria-label=\"Actions\"] button')].find(\n                        (button) => button.textContent === `Agent ${actionIndex}`,\n                    ).click();\n                }","isFunction":true,"arg":{"value":{"n":2},"handles":[]}},"pageId":"page@e1176bf61f47126a89f75cce09000e6c","beforeSnapshot":"before@call@480"}
