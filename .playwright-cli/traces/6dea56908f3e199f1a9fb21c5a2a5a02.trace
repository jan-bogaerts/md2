{"type":"before","callId":"call@484","startTime":244175.736,"class":"Frame","method":"evaluateExpression","params":{"expression":"(actionIndex) => {\n                    const state = window.j60Measurement;\n                    state.observer.disconnect();\n                    state.tasks.push(...state.taskObserver.takeRecords().map(({ startTime, duration }) => ({ startTime, duration })));\n                    state.taskObserver.disconnect();\n                    const tasks = state.tasks.filter(({ startTime, duration }) => startTime + duration > state.started && startTime <= state.ready);\n                    const preparationStart = performance.getEntriesByName(`prepare-start-agent-${actionIndex}`).at(-1).startTime;\n                    const preparationEnd = performance.getEntriesByName(`prepare-end-agent-${actionIndex}`).at(-1).startTime;\n                    return { longestRendererTask: Math.max(0, ...tasks.map(({ duration }) => duration)),\n                        totalLongTasks: tasks.reduce((sum, { duration }) => sum + duration, 0),\n                        preparationDuration: preparationEnd - preparationStart, editableAfterClick: state.ready - state.started,\n                        framePreserved: state.frame === document.querySelector('[role=\"dialog\"]'),\n                        editorPreserved: state.editor === document.querySelector('.mdxeditor-content') };\n                }","isFunction":true,"arg":{"value":{"n":2},"handles":[]}},"pageId":"page@e1176bf61f47126a89f75cce09000e6c","beforeSnapshot":"before@call@484"}
