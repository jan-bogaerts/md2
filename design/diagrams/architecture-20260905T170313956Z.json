  "meta": {
    "description": "Runtime architecture of the shared React client, Electron desktop host, persistence modes, action automation, and external integrations",
    "title": "MD² system architecture",
    "type": "architecture",
    "version": 1
  },
  "nodes": [
    {
      "drilldown": false,
      "id": "user",
      "kind": "component",
      "label": "User",
      "role": "input",
      "sublabel": "Operates the desktop or LAN browser client"
    },
    {
      "id": "react-client",
      "kind": "component",
      "label": "React Client",
      "role": "input",
      "sublabel": "Renders boards, editors, actions, search, statistics, configuration, and dialogs"
    },
    {
      "id": "renderer-domain-services",
      "kind": "component",
      "label": "Renderer Domain Services",
      "role": "focal",
      "sublabel": "Own project sessions, cards, actions, drafts, open documents, run state, navigation, and derived view state"
    },
    {
      "id": "electron-client-adapter",
      "kind": "component",
      "label": "Electron Client Adapters",
      "role": "boundary",
      "sublabel": "Expose local storage, action, runtime, configuration, lifecycle, and integration calls to renderer services"
    },
    {
      "id": "github-storage-adapter",
      "kind": "component",
      "label": "GitHub Storage Adapter",
      "role": "backend",
      "sublabel": "Loads and commits project snapshots directly through GitHub REST APIs"
    },
    {
      "id": "remote-host-adapter",
      "kind": "component",
      "label": "Remote Host Adapter",
      "role": "boundary",
      "sublabel": "Implements storage and action bridges over a reconnecting WebSocket connection"
    },
    {
      "id": "preload-ipc-bridge",
      "kind": "component",
      "label": "Sandboxed Preload Bridge",
      "role": "boundary",
      "sublabel": "Whitelists IPC requests, subscriptions, and host events for the Electron renderer"
    },
    {
      "id": "remote-control-gateway",
      "kind": "component",
      "label": "Remote Control Gateway",
      "role": "boundary",
      "sublabel": "Serves the bundled client over HTTP and maps WebSocket requests and subscriptions to host dispatch"
    },
    {
      "id": "desktop-host-dispatch",
      "kind": "component",
      "label": "Desktop Host Dispatch",
      "role": "backend",
      "sublabel": "Composes Electron main-process services and routes approved bridge operations"
    },
    {
      "id": "local-project-services",
      "kind": "component",
      "label": "Local Project and Git Services",
      "role": "backend",
      "sublabel": "Load, watch, mutate, commit, diff, branch, merge, and manage linked worktrees"
    },
    {
      "id": "action-automation",
      "kind": "component",
      "label": "Action Automation",
      "role": "focal",
      "sublabel": "Resolves definitions, schedules timers, coordinates command or agent runs, worktrees, diagrams, and activity history"
    },
    {
      "id": "agent-runtime",
      "kind": "component",
      "label": "Agent Runtime",
      "role": "backend",
      "sublabel": "Spawns Codex, Claude, or configured agents and manages streaming turns, approvals, usage, and conversation checkpoints"
    },
    {
      "id": "project-stats-worker",
      "kind": "component",
      "label": "Project Statistics Worker",
      "role": "optional",
      "sublabel": "Calculates activity and usage statistics off the main process"
    },
    {
      "id": "desktop-integration-services",
      "kind": "component",
      "label": "Desktop Integration Services",
      "role": "backend",
      "sublabel": "Provides reMarkable SFTP import, Sentry API proxying, spellcheck, and update delivery"
    },
    {
      "id": "telemetry-services",
      "kind": "component",
      "label": "Telemetry Services",
      "role": "optional",
      "sublabel": "Captures renderer and main-process usage events and errors with bounded flushing"
    },
    {
      "id": "application-state-store",
      "kind": "component",
      "label": "Application State Store",
      "role": "store",
      "sublabel": "Persists preferences, recent projects, credentials, and desktop configuration through electron-store or browser localStorage"
    },
    {
      "id": "local-project-repository",
      "kind": "component",
      "label": "Local Git Project",
      "role": "store",
      "sublabel": "Canonical project Markdown, action definitions, configuration, activity, diagrams, assets, schedules, and Git history"
    },
    {
      "drilldown": false,
      "id": "github-platform",
      "kind": "component",
      "label": "GitHub Platform",
      "role": "external",
      "sublabel": "Repository data, identity, refs, commits, releases, and installer assets"
    },
    {
      "drilldown": false,
      "id": "agent-cli-processes",
      "kind": "component",
      "label": "Agent CLI Processes",
      "role": "external",
      "sublabel": "Codex, Claude, and other configured command-line agents"
    },
    {
      "drilldown": false,
      "id": "remarkable-device",
      "kind": "component",
      "label": "reMarkable Device",
      "role": "external",
      "sublabel": "Remote image source accessed over SSH and SFTP"
    },
    {
      "drilldown": false,
      "id": "sentry-platform",
      "kind": "component",
      "label": "Sentry",
      "role": "external",
      "sublabel": "Issue import API and optional error telemetry destination"
    },
    {
      "drilldown": false,
      "id": "aptabase-platform",
      "kind": "component",
      "label": "Aptabase",
      "role": "external",
      "sublabel": "Optional usage event destination"
    }
  ]
}
