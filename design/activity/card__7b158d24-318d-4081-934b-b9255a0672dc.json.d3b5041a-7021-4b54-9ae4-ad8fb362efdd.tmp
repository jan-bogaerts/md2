afterCommit: (request) => this.cards.pushCommittedFiles(request),\r\n            clearDelay: (delayId) => window.clearTimeout(delayId),\r\n            commit: (request) => this.cards.commitFiles(request),\r\n            delayMs,\r\n            onFlushError: (error) => this.reportCommitFlushFailure(error),\r\n            onPendingChange: () => this.dispatchPersistenceChanged(),\r\n            setDelay: (callback, delay) => window.setTimeout(callback, delay),\r\n        })\r\n        this.dispatchChanged()\r\n        this.dispatchPersistenceChanged()\r\n    }\r\n\r\n    getState(): DataServiceState {\r\n        return {\r\n            project: this.projectState.project,\r\n            runningAgents: agentConversationService.getRunningAgents(),\r\n            snapshot: this.projectState.snapshot,\r\n        }\r\n    }\r\n\r\n    getPersistenceSnapshot(): DataPersistenceSnapshot {\r\n        const currentProject = this.projectState.project\r\n\r\napp\\src\\services\\data\\data_service.ts:126:            projectProvider: () => this.projectState.project,\napp\\src\\services\\data\\data_service.ts:147:            project: this.projectState.project,\napp\\src\\services\\data\\data_service.ts:154:        const currentProject = this.projectState.project\napp\\src\\services\\data\\data_service.ts:168:        const currentProject = this.projectState.project\napp\\src\\services\\data\\data_service.ts:184:        const currentProject = this.projectState.project\napp\\src\\services\\data\\data_service.ts:198:        const currentProject = this.projectState.project\napp\\src\\services\\data\\data_service.ts:234:        const currentProject = this.projectState.project\napp\\src\\services\\data\\data_service.ts:260:            project: () => this.projectState.project,\napp\\src\\services\\data\\data_service.ts:279:            project: () => this.projectState.project,\napp\\src\\services\\data\\data_service.ts:299:            project: () => this.projectState.project,\napp\\src\\services\\data\\data_service.ts:318:            project: () => this.projectState.project,\napp\\src\\services\\data\\data_service.ts:343:        const currentProject = this.projectState.project\n",
