.md\\\\\\\\\\\\\\\\` files in subdirectories, or if subdirectories contain setup instructions that are required for development, read those as well.\\\\\\\\n4. Perform all necessary project setup steps, including (where applicable):\\\\\\\\n   1. Installing dependencies.\\\\\\\\n   2. Installing toolchains or SDKs.\\\\\\\\n   3. Restoring packages.\\\\\\\\n   4. Creating generated files.\\\\\\\\n   5. Running bootstrap or setup scripts.\\\\\\\\n   6. Initializing git submodules.\\\\\\\\n   7. Installing workspace/package manager dependencies.\\\\\\\\n   8. Building any required generated artifacts.\\\\\\\\n5. Do not start long-running processes such as development servers or watch tasks unless the README explicitly requires them as part of setup.\\\\\\\\n6. If any step requires user input, elevated privileges, secrets, credentials, or external configuration, stop and explain exactly what is needed before proceeding.\\\\\\\\n7. If multiple package managers or setup methods are available, use the one recommended by the project's documentation.\\\\\\\\n8. If the documentation contains conflicting instructions, prefer the instructions in the top-level \\\\\\\\\\\\\\\\`README.md\\\\\\\\\\\\\\\\` and explain any conflict.\\\\\\\\n9. When setup is complete, provide a concise summary including:\\\\\\\\n   1. The steps that were performed.\\\\\\\\n   2. Any issues or warnings encountered.\\\\\\\\n   3. Any manual steps the developer still needs to complete.\\\\\\\\n   4. Whether the project appears ready for development.\\\\\\\\n\\\\\\\\nDo not make assumptions beyond what is documented. Base your actions on the project's documentation whenever possible.\\\\\\\",\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\worktree_service.test.mjs:66:    it('publishes an immediate snapshot and only publishes semantic changes', async () => {\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\worktree_service.test.mjs:218:    it('rechecks dirty state before parking and publishes the changed status', async () => {\\\\n.\\\\\\\\design\\\\\\\\architecture\\\\\\\\class_relationships.md:46:        class ReleaseOperations\\\\n.\\\\\\\\design\\\\\\\\architecture\\\\\\\\class_relationships.md:251:        class CompleteReleaseDialog\\\\n.\\\\\\\\design\\\\\\\\architecture\\\\\\\\class_relationships.md:286:    DataService *-- ReleaseOperations : owns release workflow\\\\n.\\\\\\\\design\\\\\\\\architecture\\\\\\\\class_relationships.md:305:    ReleaseOperations --> TelemetryService : tracks releases\\\\n.\\\\\\\\design\\\\\\\\architecture\\\\\\\\class_relationships.md:504:    AppMenu --> CompleteReleaseDialog\\\\n.\\\\\\\\design\\\\\\\\architecture\\\\\\\\class_relationships.md:520:    ProjectToolbarMenu --> CompleteReleaseDialog\\\\n.\\\\\\\\design\\\\\\\\architecture\\\\\\\\class_relationships.md:542:    CompleteReleaseDialog --> ProjectSessionService : completes release\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\worktree_service.js:93:        this.publish(null);\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\worktree_service.js:104:        this.publish(null);\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\worktree_service.js:362:        this.publish(null);\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\worktree_service.js:392:            this.publish(null);\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\worktree_service.js:397:            this.publish(message);\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\worktree_service.js:415:            this.publish(message);\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\worktree_service.js:422:        this.publish(null);\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\worktree_service.js:440:    publish(error) {\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\worktree_service.js:499:        const gitDirectory = await this.runGit(folderPath, ['rev-parse', '--git-dir']);\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\worktree_service.js:500:        const worktreeId = path.basename(path.normalize(gitDirectory)).toLowerCase().replace(/[^a-z0-9._-]+/gu, '-');\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\local_git_service.test.mjs:450:        const releaseHookPath = join(rootPath, '.git', 'release-hook');\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\local_git_service.test.mjs:460:            await writeFile(hookPath, '#!/bin/sh\\\\\\\\ntouch .git/hook-started\\\\\\\\nwhile [ ! -f .git/release-hook ]; do sleep 0.05; done\\\\\\\\n');\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\local_git_service.test.mjs:476:            await writeFile(releaseHookPath, 'release');\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\local_git_service.test.mjs:569:                message: 'Complete release v1',\\\\n.\\\\\\\\app\\\\\\\\src\\\\\\\\app\\\\\\\\use_app_bootstrap.test.ts:53:    it('publishes startup failures and still settles startup', async () => {\\\\n.\\\\\\\\app\\\\\\\\src\\\\\\\\prism_bootstrap.ts:6:// the core here, as the app's first module, publishes the global before any\\\\n.\\\\\\\\app\\\\\\\\src\\\\\\\\main.tsx:1:// Must stay the first import: it publishes the `Prism` global before the\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\git_commands.test.mjs:297:        const releaseHookPath = join(rootPath, '.git', 'release-hook');\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\git_commands.test.mjs:308:            await writeFile(hookPath, '#!/bin/sh\\\\\\\\ntouch .git/hook-started\\\\\\\\nwhile [ ! -f .git/release-hook ]; do sleep 0.05; done\\\\\\\\n');\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\git_commands.test.mjs:316:            await writeFile(releaseHookPath, 'release');\\\\n.\\\\\\\\desktop\\\\\\\\src\\\\\\\\git\\\\\\\\git_commands.js:315:    if (!await pathExists(gitPath)) throw new Error('Selected folder must contain a .git directory');\\\\n.\\\\\\\\design\\\\\\\\architecture\\\\\\\\initial description\\\\\\\\actions.md:33:- The Electron-side action runner loads the definition by `id`, resolves placeholders, executes the full chain, and publishes execution events. React displays definitions and execution state but does not run or orchestrate actions.\\\\n.\\\\\\\\design\\\\\\\\architecture\\\\\\\\initial description\\\\\\\\desktop app.md:20:    - The same server also serves the bundled React build over plain http on GET (index at `/`, assets by path, path traversal rejected, no directory listing); the WebSocket upgrade shares the one port. A LAN browser opens the QR/link, loads the app from the server, reads the token from the URL fragment and connects same-origin (`ws://` derived from `window.location`) with no manual dialog. Traffic is unencrypted on the user's own LAN; the token still gates access, and non-secure-context browser API gaps (async clipboard, service workers) need fallbacks.\\\\r\\\\n.\\\\\\\\design\\\\\\\\architecture\\\\\\\\initial description\\\\\\\\data management.md:48:    - contains a folder per release\\\\r\\\\n.\\\\\\\\design\\\\\\\\architecture\\\\\\\\initial description\\\\\\\\data management.md:49:    - md files are moved to a sub folder in the history folder when a release is done. \\\\r\\\\n.\\\\\\\\design\\\\\\\\activity\\\\\\\\card__e08c4b32-0bff-42a8-9df2-b0df009606ab.json:22:          \\\\\\\"content\\\\\\\": \\\\\\\"---\\\\\\\\r\\\\\\\\nname: technical-writer\\\\\\\\r\\\\\\\\ndescription: \\\\\\\\\\\\\\\"Use this agent when you need to create, improve, or maintain technical documentation including API references, user guides, SDK documentation, and getting-started guides.\\\\\\\\\\\\\\\"\\\\\\\\r\\\\\\\\ntools: Read, Write, Edit, Glob, Grep, WebFetch, WebSearch\\\\\\\\r\\\\\\\\nmodel: haiku\\\\\\\\r\\\\\\\\n---\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nYou are a senior technical writer with expertise in creating comprehensive, user-friendly documentation. Your focus spans API references, user guides, tutorials, and technical content with emphasis on clarity, accuracy, and helping users succeed with technical products and services.\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nWhen invoked:\\\\\\\\r\\\\\\\\n1. Query context manager for documentation needs and audience\\\\\\\\r\\\\\\\\n2. Review existing documentation, product features, and user feedback\\\\\\\\r\\\\\\\\n3. Analyze content gaps, clarity issues, and improvement opportunities\\\\\\\\r\\\\\\\\n4. Create documentation that empowers users and reduces support burden\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nTechnical writing checklist:\\\\\\\\r\\\\\\\\n- Readability score > 60 achieved\\\\\\\\r\\\\\\\\n- Technical accuracy 100% verified\\\\\\\\r\\\\\\\\n- Examples provided comprehensively\\\\\\\\r\\\\\\\\n- Visuals included appropriately\\\\\\\\r\\\\\\\\n- Version controlled properly\\\\\\\\r\\\\\\\\n- Peer reviewed thoroughly\\\\\\\\r\\\\\\\\n- SEO optimized effectively\\\\\\\\r\\\\\\\\n- User feedback positive consistently\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nDocumentation types:\\\\\\\\r\\\\\\\\n- Developer documentation\\\\\\\\r\\\\\\\\n- End-user guides\\\\\\\\r\\\\\\\\n- Administrator manuals\\\\\\\\r\\\\\\\\n- API references\\\\\\\\r\\\\\\\\n- SDK documentation\\\\\\\\r\\\\\\\\n- Integration guides\\\\\\\\r\\\\\\\\n- Best practices\\\\\\\\r\\\\\\\\n- Troubleshooting guides\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nContent creation:\\\\\\\\r\\\\\\\\n- Information architecture\\\\\\\\r\\\\\\\\n- Content planning\\\\\\\\r\\\\\\\\n- Writing standards\\\\\\\\r\\\\\\\\n- Style consistency\\\\\\\\r\\\\\\\\n- Terminology management\\\\\\\\r\\\\\\\\n- Version control\\\\\\\\r\\\\\\\\n- Review processes\\\\\\\\r\\\\\\\\n- Publishing workflows\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nAPI documentation:\\\\\\\\r\\\\\\\\n- Endpoint descriptions\\\\\\\\r\\\\\\\\n- Parameter documentation\\\\\\\\r\\\\\\\\n- Request/response examples\\\\\\\\r\\\\\\\\n- Authentication guides\\\\\\\\r\\\\\\\\n- Error references\\\\\\\\r\\\\\\\\n- Code samples\\\\\\\\r\\\\\\\\n- SDK guides\\\\\\\\r\\\\\\\\n- Integration tutorials\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nUser guides:\\\\\\\\r\\\\\\\\n- Getting started\\\\\\\\r\\\\\\\\n- Feature documentation\\\\\\\\r\\\\\\\\n- Task-based guides\\\\\\\\r\\\\\\\\n- Troubleshooting\\\\\\\\r\\\\\\\\n- FAQs\\\\\\\\r\\\\\\\\n- Video tutorials\\\\\\\\r\\\\\\\\n- Quick references\\\\\\\\r\\\\\\\\n- Best practices\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nWriting techniques:\\\\\\\\r\\\\\\\\n- Information architecture\\\\\\\\r\\\\\\\\n- Progressive disclosure\\\\\\\\r\\\\\\\\n- Task-based writing\\\\\\\\r\\\\\\\\n- Minimalist approach\\\\\\\\r\\\\\\\\n- Visual communication\\\\\\\\r\\\\\\\\n- Structured authoring\\\\\\\\r\\\\\\\\n- Single sourcing\\\\\\\\r\\\\\\\\n- Localization ready\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nDocumentation tools:\\\\\\\\r\\\\\\\\n- Markdown mastery\\\\\\\\r\\\\\\\\n- Static site generators\\\\\\\\r\\\\\\\\n- API doc tools\\\\\\\\r\\\\\\\\n- Diagramming software\\\\\\\\r\\\\\\\\n- Screenshot tools\\\\\\\\r\\\\\\\\n- Version control\\\\\\\\r\\\\\\\\n- CI/CD integration\\\\\\\\r\\\\\\\\n- Analytics tracking\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nContent standards:\\\\\\\\r\\\\\\\\n- Style guides\\\\\\\\r\\\\\\\\n- Writing principles\\\\\\\\r\\\\\\\\n- Formatting rules\\\\\\\\r\\\\\\\\n- Terminology consistency\\\\\\\\r\\\\\\\\n- Voice and tone\\\\\\\\r\\\\\\\\n- Accessibility standards\\\\\\\\r\\\\\\\\n- SEO guidelines\\\\\\\\r\\\\\\\\n- Legal compliance\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nVisual communication:\\\\\\\\r\\\\\\\\n- Diagrams\\\\\\\\r\\\\\\\\n- Screenshots\\\\\\\\r\\\\\\\\n- Annotations\\\\\\\\r\\\\\\\\n- Flowcharts\\\\\\\\r\\\\\\\\n- Architecture diagrams\\\\\\\\r\\\\\\\\n- Infographics\\\\\\\\r\\\\\\\\n- Video content\\\\\\\\r\\\\\\\\n- Interactive elements\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nReview processes:\\\\\\\\r\\\\\\\\n- Technical accuracy\\\\\\\\r\\\\\\\\n- Clarity checks\\\\\\\\r\\\\\\\\n- Completeness review\\\\\\\\r\\\\\\\\n- Consistency validation\\\\\\\\r\\\\\\\\n- Accessibility testing\\\\\\\\r\\\\\\\\n- User testing\\\\\\\\r\\\\\\\\n- Stakeholder approval\\\\\\\\r\\\\\\\\n- Continuous updates\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nDocumentation automation:\\\\\\\\r\\\\\\\\n- API doc generation\\\\\\\\r\\\\\\\\n- Code snippet extraction\\\\\\\\r\\\\\\\\n- Changelog automation\\\\\\\\r\\\\\\\\n- Link checking\\\\\\\\r\\\\\\\\n- Build integration\\\\\\\\r\\\\\\\\n- Version synchronization\\\\\\\\r\\\\\\\\n- Translation workflows\\\\\\\\r\\\\\\\\n- Metrics tracking\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n## Communication Protocol\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n### Documentation Context Assessment\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nInitialize technical writing by understanding documentation needs.\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nDocumentation context query:\\\\\\\\r\\\\\\\\n```json\\\\\\\\r\\\\\\\\n{\\\\\\\\r\\\\\\\\n  \\\\\\\\\\\\\\\"requesting_agent\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"technical-writer\\\\\\\\\\\\\\\",\\\\\\\\r\\\\\\\\n  \\\\\\\\\\\\\\\"request_type\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"get_documentation_context\\\\\\\\\\\\\\\",\\\\\\\\r\\\\\\\\n  \\\\\\\\\\\\\\\"payload\\\\\\\\\\\\\\\": {\\\\\\\\r\\\\\\\\n    \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Documentation context needed: product features, target audiences, existing docs, pain points, preferred formats, and success metrics.\\\\\\\\\\\\\\\"\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n```\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n## Development Workflow\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nExecute technical writing through systematic phases:\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n### 1. Planning Phase\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nUnderstand documentation requirements and audience.\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nPlanning priorities:\\\\\\\\r\\\\\\\\n- Audience analysis\\\\\\\\r\\\\\\\\n- Content audit\\\\\\\\r\\\\\\\\n- Gap identification\\\\\\\\r\\\\\\\\n- Structure design\\\\\\\\r\\\\\\\\n- Tool selection\\\\\\\\r\\\\\\\\n- Timeline planning\\\\\\\\r\\\\\\\\n- Review process\\\\\\\\r\\\\\\\\n- Success metrics\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nContent strategy:\\\\\\\\r\\\\\\\\n- Define objectives\\\\\\\\r\\\\\\\\n- Identify audiences\\\\\\\\r\\\\\\\\n- Map user journeys\\\\\\\\r\\\\\\\\n- Plan content types\\\\\\\\r\\\\\\\\n- Create outlines\\\\\\\\r\\\\\\\\n- Set standards\\\\\\\\r\\\\\\\\n- Establish workflows\\\\\\\\r\\\\\\\\n- Define metrics\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n### 2. Implementation Phase\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nCreate clear, comprehensive documentation.\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nImplementation approach:\\\\\\\\r\\\\\\\\n- Research thoroughly\\\\\\\\r\\\\\\\\n- Write clearly\\\\\\\\r\\\\\\\\n- Include examples\\\\\\\\r\\\\\\\\n- Add visuals\\\\\\\\r\\\\\\\\n- Review accuracy\\\\\\\\r\\\\\\\\n- Test usability\\\\\\\\r\\\\\\\\n- Gather feedback\\\\\\\\r\\\\\\\\n- Iterate continuously\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nWriting patterns:\\\\\\\\r\\\\\\\\n- User-focused approach\\\\\\\\r\\\\\\\\n- Clear structure\\\\\\\\r\\\\\\\\n- Consistent style\\\\\\\\r\\\\\\\\n- Practical examples\\\\\\\\r\\\\\\\\n- Visual aids\\\\\\\\r\\\\\\\\n- Progressive complexity\\\\\\\\r\\\\\\\\n- Searchable content\\\\\\\\r\\\\\\\\n- Regular updates\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nProgress tracking:\\\\\\\\r\\\\\\\\n```json\\\\\\\\r\\\\\\\\n{\\\\\\\\r\\\\\\\\n  \\\\\\\\\\\\\\\"agent\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"technical-writer\\\\\\\\\\\\\\\",\\\\\\\\r\\\\\\\\n  \\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"documenting\\\\\\\\\\\\\\\",\\\\\\\\r\\\\\\\\n  \\\\\\\\\\\\\\\"progress\\\\\\\\\\\\\\\": {\\\\\\\\r\\\\\\\\n    \\\\\\\\\\\\\\\"pages_written\\\\\\\\\\\\\\\": 127,\\\\\\\\r\\\\\\\\n    \\\\\\\\\\\\\\\"apis_documented\\\\\\\\\\\\\\\": 45,\\\\\\\\r\\\\\\\\n    \\\\\\\\\\\\\\\"readability_score\\\\\\\\\\\\\\\": 68,\\\\\\\\r\\\\\\\\n    \\\\\\\\\\\\\\\"user_satisfaction\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"92%\\\\\\\\\\\\\\\"\\\\\\\\r\\\\\\\\n  }\\\\\\\\r\\\\\\\\n}\\\\\\\\r\\\\\\\\n```\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n### 3. Documentation Excellence\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nDeliver documentation that drives success.\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nExcellence checklist:\\\\\\\\r\\\\\\\\n- Content comprehensive\\\\\\\\r\\\\\\\\n- Accuracy verified\\\\\\\\r\\\\\\\\n- Usability tested\\\\\\\\r\\\\\\\\n- Feedback incorporated\\\\\\\\r\\\\\\\\n- Search optimized\\\\\\\\r\\\\\\\\n- Maintenance planned\\\\\\\\r\\\\\\\\n- Impact measured\\\\\\\\r\\\\\\\\n- Users empowered\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nDelivery notification:\\\\\\\\r\\\\\\\\n\\\\\\\\\\\\\\\"Documentation completed. Created 127 pages covering 45 APIs with average readability score of 68. User satisfaction increased to 92% with 73% reduction in support tickets. Documentation-driven adoption increased by 45%.\\\\\\\\\\\\\\\"\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nInformation architecture:\\\\\\\\r\\\\\\\\n- Logical organization\\\\\\\\r\\\\\\\\n- Clear navigation\\\\\\\\r\\\\\\\\n- Consistent structure\\\\\\\\r\\\\\\\\n- Intuitive categorization\\\\\\\\r\\\\\\\\n- Effective search\\\\\\\\r\\\\\\\\n- Cross-references\\\\\\\\r\\\\\\\\n- Related content\\\\\\\\r\\\\\\\\n- User pathways\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nWriting excellence:\\\\\\\\r\\\\\\\\n- Clear language\\\\\\\\r\\\\\\\\n- Active voice\\\\\\\\r\\\\\\\\n- Concise sentences\\\\\\\\r\\\\\\\\n- Logical flow\\\\\\\\r\\\\\\\\n- Consistent terminology\\\\\\\\r\\\\\\\\n- Helpful examples\\\\\\\\r\\\\\\\\n- Visual breaks\\\\\\\\r\\\\\\\\n- Scannable format\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nAPI documentation best practices:\\\\\\\\r\\\\\\\\n- Complete coverage\\\\\\\\r\\\\\\\\n- Clear descriptions\\\\\\\\r\\\\\\\\n- Working examples\\\\\\\\r\\\\\\\\n- Error handling\\\\\\\\r\\\\\\\\n- Authentication details\\\\\\\\r\\\\\\\\n- Rate limits\\\\\\\\r\\\\\\\\n- Versioning info\\\\\\\\r\\\\\\\\n- Quick start guide\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nUser guide strategies:\\\\\\\\r\\\\\\\\n- Task orientation\\\\\\\\r\\\\\\\\n- Step-by-step instructions\\\\\\\\r\\\\\\\\n- Visual aids\\\\\\\\r\\\\\\\\n- Common scenarios\\\\\\\\r\\\\\\\\n- Troubleshooting tips\\\\\\\\r\\\\\\\\n- Best practices\\\\\\\\r\\\\\\\\n- Advanced features\\\\\\\\r\\\\\\\\n- Quick references\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nContinuous improvement:\\\\\\\\r\\\\\\\\n- User feedback collection\\\\\\\\r\\\\\\\\n- Analytics monitoring\\\\\\\\r\\\\\\\\n- Regular updates\\\\\\\\r\\\\\\\\n- Content refresh\\\\\\\\r\\\\\\\\n- Broken link checks\\\\\\\\r\\\\\\\\n- Accuracy verification\\\\\\\\r\\\\\\\\n- Performance optimization\\\\\\\\r\\\\\\\\n- New feature documentation\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nIntegration with other agents:\\\\\\\\r\\\\\\\\n- Collaborate with product-manager on features\\\\\\\\r\\\\\\\\n- Support developers on API docs\\\\\\\\r\\\\\\\\n- Work with ux-researcher on user needs\\\\\\\\r\\\\\\\\n- Guide support teams on FAQs\\\\\\\\r\\\\\\\\n- Help marketing on content\\\\\\\\r\\\\\\\\n- Assist sales-engineer on materials\\\\\\\\r\\\\\\\\n- Partner with customer-success on guides\\\\\\\\r\\\\\\\\n- Coordinate with legal-advisor on compliance\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\nAlways prioritize clarity, accuracy, and user success while creating documentation that reduces friction and enables users to achieve their goals efficiently.\\\\\\\\r\\\\\\\\n\\\\\\\",\\\\n.\\\\\\\\design\\\\\\\\activity\\\\\\\\card__e08c4b32-0bff-42a8-9df2-b0df009606ab.json:46:          \\\\\\\"content\\\\\\\": \\\\\\\"design\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_002_github_push_semantics.md:26:- If the fallback UI-honesty option is chosen instead: GitHub mode shows no manual-push option and the docs/config reflect that.\\\\\\\\ndesktop\\\\\\\\\\\\\\\\vitest.config.mjs:1:import { defineConfig } from 'vitest/config';\\\\\\\\ndesktop\\\\\\\\\\\\\\\\vitest.config.mjs:3:export default defineConfig({});\\\\\\\\ndesktop\\\\\\\\\\\\\\\\electron-builder.config.cjs:1:const { createBuilderConfig } = require('./packaging/builder_config')\\\\\\\\ndesktop\\\\\\\\\\\\\\\\electron-builder.config.cjs:3:module.exports = createBuilderConfig()\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:1:const { app, BrowserWindow, Menu, dialog, ipcMain, nativeTheme, shell } = require('electron');\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:11:const { readDesktopConfig, resolveBridgeAllowedOrigins, writeDesktopConfig } = require('./src/shell/config');\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:67:    agentConfigProvider: () => readDesktopConfig(store),\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:82:    desktopConfigStore: store,\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:87:    readDesktopConfig,\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:98:    const result = await dialog.showOpenDialog(window, {\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:109:    const result = await dialog.showOpenDialog(window, {\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:161:function registerConfigBridge() {\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:162:    ipcMain.handle(CONFIG_GET_DESKTOP_CHANNEL, () => readDesktopConfig(store));\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:163:    ipcMain.handle(CONFIG_SET_DESKTOP_CHANNEL, (_event, values) => writeDesktopConfig(store, values));\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:201:    const desktopConfig = readDesktopConfig(store);\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:204:        ? resolveBridgeAllowedOrigins(desktopConfig, rendererTarget.url)\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:218:                `--md2-desktop-config=${encodeURIComponent(JSON.stringify(desktopConfig))}`,\\\\\\\\ndesktop\\\\\\\\\\\\\\\\main.js:322:    registerConfigBridge();\\\\\\\\ndesktop\\\\\\\\\\\\\\\\eslint.config.js:51:            ...js.configs.recommended.rules,\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_006_agent_command_sources.md:15:Action starts and conversation continuation currently resolve agent configuration through different paths. Moving action orchestration to Electron must also remove React-side executable-command resolution.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_006_agent_command_sources.md:19:- Make persisted desktop config the single source of truth.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_006_agent_command_sources.md:26:- Changing supported agent configuration affects action runs and continuation immediately and after restart.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_006_agent_command_sources.md:29:- Tests cover both entry points and persisted config resolution.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_006_agent_command_sources.md:35:- `design\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\ready\\\\\\\\\\\\\\\\F_031_config_persistence.md`\\\\\\\\ndesktop\\\\\\\\\\\\\\\\package.json:10:    \\\\\\\\\\\\\\\"package:windows\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"electron-builder --config electron-builder.config.cjs --win nsis --x64\\\\\\\\\\\\\\\",\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_005_system_agent_option.md:14:Still present after the F-033 agent-profile rework (2026-07-06 audit). The built-in profile list (`BUILTIN_AGENT_PROFILES` in `app/src/data/agent_profiles.ts` and its duplicate `desktop/agent_profiles.js`) contains `{ command: 'system', name: 'system' }`, and `buildAgentCommand`/`resolveAgentCommand` use the profile's `command` verbatim as the shell command. Selecting the `system` profile (app menu, action popup, action json or `desktop.agent` config) spawns a process literally named `system`, which fails — there is still no mapping to any real default agent.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_005_system_agent_option.md:18:* remove the fake `system` built-in profile — user-defined profiles with free-form commands now cover the \\\\\\\\\\\\\\\"configurable agent string\\\\\\\\\\\\\\\" requirement, and `codex`/`claude` remain sensible defaults.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_005_system_agent_option.md:23:* No selectable config value causes a spawn of a nonexistent literal command.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_005_system_agent_option.md:24:* The agent command is configurable as text and used consistently by all agent execution paths.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_005_system_agent_option.md:31:* `design\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_031_config_persistence.md`\\\\\\\\ndesktop\\\\\\\\\\\\\\\\package-lock.json:538:    \\\\\\\\\\\\\\\"node_modules/@eslint/config-array\\\\\\\\\\\\\\\": {\\\\\\\\ndesktop\\\\\\\\\\\\\\\\package-lock.json:540:      \\\\\\\\\\\\\\\"resolved\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"https://registry.npmjs.org/@eslint/config-array/-/config-array-0.21.2.tgz\\\\\\\\\\\\\\\",\\\\\\\\ndesktop\\\\\\\\\\\\\\\\package-lock.json:553:    \\\\\\\\\\\\\\\"node_modules/@eslint/config-helpers\\\\\\\\\\\\\\\": {\\\\\\\\ndesktop\\\\\\\\\\\\\\\\package-lock.json:555:      \\\\\\\\\\\\\\\"resolved\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"https://registry.npmjs.org/@eslint/config-helpers/-/config-helpers-0.4.2.tgz\\\\\\\\\\\\\\\",\\\\\\\\ndesktop\\\\\\\\\\\\\\\\package-lock.json:3987:        \\\\\\\\\\\\\\\"@eslint/config-array\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"^0.21.2\\\\\\\\\\\\\\\",\\\\\\\\ndesktop\\\\\\\\\\\\\\\\package-lock.json:3988:        \\\\\\\\\\\\\\\"@eslint/config-helpers\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"^0.4.2\\\\\\\\\\\\\\\",\\\\\\\\ndesktop\\\\\\\\\\\\\\\\package-lock.json:4113:        \\\\\\\\\\\\\\\"tsconfig-paths\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"^3.15.0\\\\\\\\\\\\\\\"\\\\\\\\ndesktop\\\\\\\\\\\\\\\\package-lock.json:7947:    \\\\\\\\\\\\\\\"node_modules/tsconfig-paths\\\\\\\\\\\\\\\": {\\\\\\\\ndesktop\\\\\\\\\\\\\\\\package-lock.json:7949:      \\\\\\\\\\\\\\\"resolved\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"https://registry.npmjs.org/tsconfig-paths/-/tsconfig-paths-3.15.0.tgz\\\\\\\\\\\\\\\",\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_012_left_panel_layout.md:19:- Relocate `GithubAuthPanel` to a sensible home: the toolbar (account button/menu) or the project-open dialog (pairs with F-027/B-019).\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_012_left_panel_layout.md:25:- Auth is still reachable (toolbar or dialog) in both modes.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_015_electron_context_isolation.md:14:`desktop/main.js` creates the window with `contextIsolation: false, sandbox: false`, and `preload.js` assigns bridge objects (and its closure over Node modules like `child_process`, `fs`, git) directly onto `window`. The window loads a **configurable, remotely deployed URL** (J-001 design). Any compromise of that site — or of any dependency it ships — gains transitive access to shell execution and the filesystem. This is a real security defect, not a style preference.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_015_electron_context_isolation.md:24:- All existing bridge features (data, auth proxy, theme, config, actions) work unchanged through `contextBridge`.\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.js:30:function assertSigningIdentityIsConfigured(secrets) {\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.js:39:function createBuilderConfig(secrets = loadSigningSecrets()) {\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.js:40:    assertSigningIdentityIsConfigured(secrets);\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.js:105:    createBuilderConfig,\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:14:    createBuilderConfig,\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:17:} = require('./builder_config');\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:19:describe('electron-builder configuration', () => {\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:21:        const config = createBuilderConfig({ certificateSubjectName: 'Example Certificate' });\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:23:        expect(config).toMatchObject({\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:35:        expect(config.files).toContainEqual(expect.objectContaining({ from: '.', to: 'desktop' }));\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:36:        expect(config.files).toContainEqual(expect.objectContaining({ from: '../app/dist', to: 'desktop/renderer' }));\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:37:        expect(config.files).toContainEqual(expect.objectContaining({ from: '../shared', to: 'shared' }));\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:38:        expect(config.extraResources).toEqual([{ from: '.env', to: '.env' }]);\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:41:    it('selects a certificate-store identity only when configured', () => {\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:55:    it('uses the default timestamp server unless an override is configured', () => {\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:62:        expect(() => createBuilderConfig({ publisherName: 'Example Publisher' })).toThrow('Missing signing identity');\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\builder_config.test.mjs:63:        expect(() => createBuilderConfig({ certificateSha1: 'ABC123' })).not.toThrow();\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_016_config_init_during_render.md:3:title: config service initialized during component render\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_016_config_init_during_render.md:14:`ensureConfigServiceInitialized()` is called in the render body of `ProjectWorkspace` and `ConfigPage`. That is a side effect during render, against the documented two-phase service lifecycle (\\\\\\\\\\\\\\\"Config-dependent work runs in init()/start()/app bootstrap\\\\\\\\\\\\\\\"), and fragile under React StrictMode double-rendering and future concurrent rendering.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_016_config_init_during_render.md:17:- Initialize `configService` exactly once in app bootstrap: `useAppBootstrap` already calls `configService.init(...)` — make that unconditional and early (before any component that might read config renders), including the no-last-project path.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_016_config_init_during_render.md:18:- Delete both `ensureConfigServiceInitialized` helpers; components assume an initialized service and fail loudly otherwise (the service already throws).\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_016_config_init_during_render.md:19:- `ConfigPage`'s `useState(() => configService.loadDraft())` initializer also mutates service state during render — move draft loading into a `useEffect` (or an explicit open handler) with state set afterwards.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_016_config_init_during_render.md:22:- No component calls `configService.init` or `loadDraft` during render.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_016_config_init_during_render.md:25:- Existing config tests still pass; a test asserts init happens once during bootstrap.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_016_config_init_during_render.md:29:- `design\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_016_config.md`\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_018_card_creation_feature_only.md:14:The new-card form in `ProjectWorkspace` hardcodes `type: 'feature'` and the button reads \\\\\\\\\\\\\\\"Create Feature\\\\\\\\\\\\\\\". Card types (feature/job/bug + configurable prefixes and colors) are fully modeled in config and naming, but jobs and bugs cannot be created from the UI.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_018_card_creation_feature_only.md:17:- Add a card-type selector to the new-card form, fed from `projectConfig.cardTypes` (label + color swatch), defaulting to feature.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_018_card_creation_feature_only.md:19:- Longer term the new-card form should move into a dialog opened from the card view (\\\\\\\\\\\\\\\"add card\\\\\\\\\\\\\\\" per column would set the initial status), but the selector is the minimum fix.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_018_card_creation_feature_only.md:22:- A card of every configured type can be created; the generated filename uses that type's id prefix.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_018_card_creation_feature_only.md:23:- The type list reflects project config (custom types included), not a hardcoded enum.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_019_project_open_form_placement.md:14:The owner/repository/branch fields, open buttons, push-mode select and new-card row are always rendered above the card/text views in `ProjectWorkspace`. The design puts create/open/switch-branch in menus (`data management.md`: \\\\\\\\\\\\\\\"allow switch branch from menu\\\\\\\\\\\\\\\"; config.md pattern). The permanent form wastes vertical space on every screen — especially mobile — and mixes rarely-used setup controls with the daily working surface.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_019_project_open_form_placement.md:17:- Move open/create project into a dialog reachable from the toolbar (project menu button), combined with the F-027 repository/branch pickers.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_019_project_open_form_placement.md:19:- New-card entry moves to a compact affordance in the card view (e.g. \\\\\\\\\\\\\\\"+ card\\\\\\\\\\\\\\\" per column or a single toolbar button opening a small dialog with title/type/body).\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_019_project_open_form_placement.md:26:- Mobile layout gains the reclaimed space; tests cover the dialog flow and empty state.\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\BUILDING_WINDOWS.md:16:## Signing configuration\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\BUILDING_WINDOWS.md:26:For hardware-backed certificates or certificates installed in Windows certificate store, do not export key. Configure one or both selectors:\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_021_commit_noop_failure.md:18:- Same guard in `saveProjectConfig` and `createProject` commit paths.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_023_dead_code_cleanup.md:17:Status per item re-verified 2026-07-08 (audit): the re-export shims and the duplicated test file are **deleted**, the README template is now **one constant per side** (`PROJECT_README_TEMPLATE` in `github_storage_service.ts` and `desktop/project_files.js`) as accepted, `splitCards` parses each file **once** (two filter passes remain, acceptable), `void configRevision` is gone (B-031 done), and the duplicated `agent_profiles` module is resolved by shared validators in [[J-012]]. Still open: the action-reload debounce single-path issue — extracted to its own card, see [[B-039]].\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_023_dead_code_cleanup.md:20:- ~~**Dead config entries**~~ **done** — `react.showStartupSplash` gates the splash in `app.tsx`, `connection.githubScopes` feeds `github_auth_service` (F-031). _(Update 2026-07-11: `connection.githubScopes` and the whole Connection config section were later removed with OAuth — see [[F_034_github_oauth_cors_proxy]]. Auth is now PAT-only, which takes no scopes.)_\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_023_dead_code_cleanup.md:27:- **`void configRevision` re-render hack** in `ProjectWorkspace` → now tracked as its own bug, see [[B-031]].\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_023_dead_code_cleanup.md:34:- No `/config` entry remains that has no behavioral effect (coordinated with F-031).\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_023_dead_code_cleanup.md:38:- `design\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_031_config_persistence.md`\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_024_swallowed_errors.md:15:- **Still open**: `DataService.getConfig()` catches all errors and returns `null` — a config-service bug looks like \\\\\\\\\\\\\\\"no project config\\\\\\\\\\\\\\\".\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_024_swallowed_errors.md:20:- ~~`handleCreateCardClick`/`handlePushClick` unhandled~~ **done** — both report through `reportWorkspaceError`/dialog error state.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_024_swallowed_errors.md:26:- `getConfig()` stops catching; callers handle the not-initialized case explicitly.\\\\\\\\ndesktop\\\\\\\\\\\\\\\\packaging\\\\\\\\\\\\\\\\verify_windows_package.mjs:11:const { loadSigningSecrets } = createRequire(import.meta.url)('./builder_config');\\\\\\\\ndesktop\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\git\\\\\\\\\\\\\\\\diff_service.js:111:/** Run the configured diff command for a commit and return normalized diff data. */\\\\\\\\ndesktop\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\git\\\\\\\\\\\\\\\\git_commands.test.mjs:31:    await runGit(rootPath, ['config', 'user.email', 'md2-test@example.com']);\\\\\\\\ndesktop\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\git\\\\\\\\\\\\\\\\git_commands.test.mjs:32:    await runGit(rootPath, ['config', 'user.name', 'MD2 Test']);\\\\\\\\ndesktop\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\renderer_security.test.mjs:7:const { DEFAULT_APP_URL } = require('./config');\\\\\\\\ndesktop\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\renderer_security.test.mjs:19:    it('uses the configured Vite URL while unpackaged', () => {\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_031_render_time_service_reads.md:16:- `ProjectWorkspace` (`app/src/components/project_workspace.tsx`) calls `dataService.getConfig()` in the render body and keeps a `configRevision` counter — incremented from a `configService` `changed` listener and consumed as `void configRevision` — purely to force a re-render so the next render re-reads the service. This is a hand-rolled, easy-to-break substitute for a subscription.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_031_render_time_service_reads.md:17:- `AppMenu` (`app/src/components/shell/menu/app_menu.tsx`) calls `dataService.getConfig()` in render and seeds `useState` from `configService.get('desktop.agent'/'desktop.model')`, so a config change made elsewhere (config page save, another menu instance) does not refresh the menu until remount.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_031_render_time_service_reads.md:18:- `ActionPopup` reads `configService` in `useState` initializers with an `isInitialized()` escape hatch (`readDefaultAgentSelection`), same staleness pattern.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_031_render_time_service_reads.md:24:  - `useProjectConfig()` — `useSyncExternalStore` over `dataService` `changed` events returning `dataService.getConfig()`;\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_031_render_time_service_reads.md:25:  - `useConfigValue(key)` (or `useConfigValues(keys)`) — `useSyncExternalStore` over `configService` `changed` events.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_031_render_time_service_reads.md:26:- Replace the direct render-body reads in `ProjectWorkspace`, `AppMenu` and `ActionPopup` with these hooks; delete the `configRevision` counter and its listener effect.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_031_render_time_service_reads.md:30:- Saving a config change on `/config` immediately updates the app menu's agent/model selection and any open action popup defaults without remounting.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_031_render_time_service_reads.md:31:- `ProjectWorkspace` re-renders on project-config changes without the revision-counter hack (`void configRevision` is gone).\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_031_render_time_service_reads.md:32:- No component calls `configService.get`/`dataService.getConfig` in a render body outside the shared hooks (grep-verifiable).\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_031_render_time_service_reads.md:36:- `design\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_016_config_init_during_render.md`\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_031_render_time_service_reads.md:37:- `design\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_016_config.md`\\\\\\\\ndesktop\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\renderer_security.js:3:const { resolveAppUrl } = require('./config');\\\\\\\\napp\\\\\\\\\\\\\\\\vite.config.ts:6:import { defineConfig } from 'vitest/config'\\\\\\\\napp\\\\\\\\\\\\\\\\vite.config.ts:38:    const mapPath = resolve(server.config.root, relativePath)\\\\\\\\napp\\\\\\\\\\\\\\\\vite.config.ts:39:    const optimizedDependencyDirectory = resolve(server.config.root, 'node_modules', '.vite', 'deps')\\\\\\\\napp\\\\\\\\\\\\\\\\vite.config.ts:96:        configureServer(server) {\\\\\\\\napp\\\\\\\\\\\\\\\\vite.config.ts:102:export default defineConfig({\\\\\\\\ndesktop\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\preload.test.mjs:16:    const desktopConfig = options.desktopConf