State<ColorSchemeConfig>(readInitialColorScheme)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:102:    const [markdownStyleConfig, setMarkdownStyleConfig] = useState<MarkdownStyleConfig>(initialMarkdownStyle.config)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:112:    const setColorScheme = useCallback((nextColorScheme: ColorSchemeConfig) => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:120:        setMarkdownStyleConfig(MARKDOWN_STYLE_PRESETS[preset])\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:123:    const setCustomMarkdownStyle = useCallback((nextMarkdownStyleConfig: MarkdownStyleConfig) => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:124:        const config = cloneMarkdownStyleConfig(nextMarkdownStyleConfig)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:126:        window.localStorage.setItem(CUSTOM_MARKDOWN_STYLE_STORAGE_KEY, JSON.stringify(config))\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:128:        setMarkdownStyleConfig(config)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:136:            markdownStyleConfig,\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:146:            markdownStyleConfig,\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_002_data_management.md:23:- Project create/open loads the configured working folder, defaults to `design`, asks for another folder if missing, and can create template content when no folder exists.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_002_data_management.md:24:- Card creation writes a markdown file in the working folder using `{id}-{title}.md`; ids are configurable per card type and default to `F-{number}`, `J-{number}`, `B-{number}` using the next available number across the folder and subfolders.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_002_data_management.md:33:- The configured working folder is loaded from the project; missing folders trigger folder selection or template-based creation.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_002_data_management.md:35:- New cards are created, committed and named with the configured id and `{id}-{title}.md` convention.\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:4:import { dialogService } from '../services/dialog_service'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:211:        expect(await screen.findByRole('dialog', { name: 'Worktree has uncommitted changes' })).toBeInTheDocument()\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:233:    it('opens the dirty dialog when backend revalidation rejects parking', async () => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:251:        expect(await screen.findByRole('dialog', { name: 'Worktree has uncommitted changes' })).toBeInTheDocument()\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:300:    it('opens the commit dialog with the default card message', () => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:320:        expect(screen.getByRole('dialog', { name: 'Commit worktree' })).toBeInTheDocument()\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:327:    it('reports commit errors through dialogService and leaves the commit dialog open', async () => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:332:        const reportError = vi.spyOn(dialogService, 'error')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:340:        expect(screen.getByRole('dialog', { name: 'Commit worktree' })).toBeInTheDocument()\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:343:    it('closes the commit dialog and reports an integration error after the commit succeeds', async () => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:349:        const reportError = vi.spyOn(dialogService, 'error')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:359:            expect(screen.queryByRole('dialog', { name: 'Commit and integrate worktree' })).not.toBeInTheDocument()\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:363:    it('reports update errors through dialogService', async () => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:370:        const reportError = vi.spyOn(dialogService, 'error')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:379:    it('reports integration errors through dialogService', async () => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.test.tsx:387:        const reportError = vi.spyOn(dialogService, 'error')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:3:export const DIALOG_SERVICE_EVENT = 'md2:dialog-message'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:5:export type DialogSeverity = 'error' | 'warning' | 'info' | 'success'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:7:export interface DialogServiceMessage {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:11:    severity: DialogSeverity\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:15:export interface DialogServiceOptions {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:21:const DEFAULT_TITLES: Record<DialogSeverity, string> = {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:35:/** Central notification service for user-visible messages and blocking dialogs. */\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:36:export class DialogService extends EventTarget {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:41:        register('dialogService', this)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:44:    error(error: unknown, options: DialogServiceOptions = {}) {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:50:    warning(message: string, options: DialogServiceOptions = {}) {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:54:    info(message: string, options: DialogServiceOptions = {}) {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:58:    success(message: string, options: DialogServiceOptions = {}) {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:62:    private show(severity: DialogSeverity, message: string, options: DialogServiceOptions) {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:63:        if (message.length === 0) throw new Error('Dialog message is required')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:65:        const dialogMessage = {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:73:        this.dispatchEvent(new CustomEvent<DialogServiceMessage>(DIALOG_SERVICE_EVENT, { detail: dialogMessage }))\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:75:        return dialogMessage\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.ts:79:export const dialogService = new DialogService()\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_003_special_folders.md:21:- Recognize special folders inside the working folder: `history`, `architecture` and `prompts` (actions). Names should be configurable, defaulting to these.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_003_special_folders.md:30:- The `history`, `architecture` and `prompts` folders are recognized when a project is loaded, using configured or default names.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_005_card_view.md:17:Parsing now lives behind the shared `markdownParsingService` ([[F-021]]), whose `parseCard`/`splitCards` create `ProjectCard`s that `DataService` can save. `CardTypeConfig` already carries a per-type `color` (added with theming, [[F-018]]). `CardHeader` has `id`, `title`, `status`, `owner`, `affects` and `internalId`, but not parsed `after` ordering or `policy`. `ProjectWorkspace` still shows active cards as a flat `CardSelectButton` list with a plain `TextField` textarea editor — no columns, drag-and-drop, policy leds, type-color line, inline title editing, or body dialog/accordion. No drag-and-drop library is installed.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_005_card_view.md:20:- Data model: parse `after` and `policy` in the shared parsing service, add them to `CardHeader`, and keep `internalId` as the stable identity referenced by `after`. Extend `CardTypeConfig` with a per-type color.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_005_card_view.md:24:- Editing/navigation: double-click or edit affordance enables inline title editing, updates `header.title`, and saves. Clicking a card opens the markdown body in a desktop dialog or expands it inline as a mobile accordion; body editing and toolbar behavior come from the markdown editor ([[F-007]]). A card/dialog action switches to file mode ([[F-006]]) with that card open.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_005_card_view.md:32:- On desktop, clicking a card opens its body in a dialog; on mobile, the card expands as an accordion with the body inline.\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_commit_dialog.tsx:1:import { Button, Dialog, DialogActions, DialogContent, DialogTitle, TextField, Typography } from '@mui/material'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_commit_dialog.tsx:4:interface WorktreeCommitDialogProps {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_commit_dialog.tsx:15:export function WorktreeCommitDialog(props: WorktreeCommitDialogProps) {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_commit_dialog.tsx:25:        <Dialog fullWidth maxWidth=\\\\\\\\\\\\\\\"xs\\\\\\\\\\\\\\\" onClose={onClose} open={open}>\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_commit_dialog.tsx:26:            <DialogTitle>{title}</DialogTitle>\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_commit_dialog.tsx:27:            <DialogContent sx={{ display: 'flex', flexDirection: 'column', gap: 1, pt: 1 }}>\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_commit_dialog.tsx:30:            </DialogContent>\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_commit_dialog.tsx:31:            <DialogActions>\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_commit_dialog.tsx:36:      