          "content": "344-        readOptionalString(request?.actionId, 'actionId');\n345-        const cardPath = readOptionalString(request?.cardPath, 'cardPath');\n346-        const prompt = requireString(request?.prompt, 'prompt');\n347-        const agent = requireString(request?.agent ?? 'generic', 'agent');\n348-        const streaming = request.streaming === true;\n349-        requireProjectFolder(request?.projectFolder);\n350-        if (cardPath) ensureInsideRoot(rootPath, path.join(rootPath, cardPath));\n351-\n352-        const id = `agent-turn-${crypto.randomUUID()}`;\n353-        const startedAt = new Date().toISOString();\n354-        const conversationId = request.conversation?.id ?? `agent-${crypto.randomUUID()}`;\n355-        const reference = request.reference ?? conversationReference(request, conversationId);\n356:        const conversation = createConversation(request, conversationId, startedAt, reference);\n357-        let nextSequence = nextConversationSequence(conversation);\n358-        if (this.runningConversationIds.has(conversation.id)) throw new Error(`Agent conversation already has a running turn: ${conversation.id}`);\n359-        const lastMessage = lastMessageEntry(conversation);\n360-        if (request.reuseLastUserMessage) {\n361-            if (lastMessage?.role !== 'user' || lastMessage.content !== prompt) throw new Error('Missing failed-turn user message for agent retry');\n362-        } else {\n363-            conversation.entries.push(createMessageEntry(`${id}-user`, 'user', prompt, startedAt, undefined, nextSequence));\n364-            nextSequence += 1;\n365-        }\n366-        conversation.entries.push(createEventEntry(`${id}-started`, 'started', command.join(' '), startedAt, nextSequence));\n367-        nextSequence += 1;\n368-        const [configuredExecutable, ...configuredArguments] = command;\n",
