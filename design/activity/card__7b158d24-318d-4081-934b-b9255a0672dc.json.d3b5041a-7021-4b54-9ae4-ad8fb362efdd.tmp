  setCommitDialogOpen(false)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:194:            dialogService.error(error, { fallbackMessage: 'Could not commit worktree changes' })\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:210:            dialogService.error(error, { fallbackMessage })\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:213:    const handleUnassignClose = () => setUnassignDialogOpen(false)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:219:            setUnassignDialogOpen(false)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:221:            dialogService.error(error, { fallbackMessage: 'Could not drop worktree changes' })\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:230:            dialogService.error(error, { fallbackMessage: 'Could not commit worktree changes' })\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:237:            setUnassignDialogOpen(false)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:238:            dialogService.error(error, { fallbackMessage: 'Changes were committed, but the worktree could not be integrated into the project' })\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:244:            setUnassignDialogOpen(false)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:246:            setUnassignDialogOpen(false)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:247:            dialogService.error(error, { fallbackMessage: 'Changes were integrated, but the worktree could not be unassigned' })\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:333:            <WorktreeCommitDialog\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:337:                onClose={handleCommitDialogClose}\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:340:                open={commitDialogOpen}\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:342:            <WorktreeUnassignDialog\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\worktree_selector.tsx:349:                open={unassignDialogOpen}\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F-7-electron-local-folder-project-mode.md:17:Most of the local implementation already exists. `LocalGitStorageService` routes file, config, branch, commit, push and watch operations through `window.md2Data`; Electron also runs actions, agents and diffs against `project.rootPath`.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F-7-electron-local-folder-project-mode.md:22:- The Electron project dialog still defaults to GitHub and treats Local as an optional source. The existing desktop config value `projectLocationMode: 'folder'` is not consumed by the React project-opening flow.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F-7-electron-local-folder-project-mode.md:30:- Resolve the selected folder with Git (`git rev-parse --show-toplevel`) and require a valid work tree. Normalize the returned `rootPath` and `id` to the repository root. A selection outside a Git work tree must fail with a clear dialog error.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F-7-electron-local-folder-project-mode.md:33:- Continue using `LocalGitStorageService` for project data. File reads and writes, project config, actions, schedules, agent logs, diffs, commits, branch changes, pushes and file watching must remain rooted under the normalized project folder.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F-7-electron-local-folder-project-mode.md:34:- Use the local repository's configured Git remotes and the user's Git credential manager or SSH setup for push. Electron project opening must not require GitHub authentication or instantiate `GithubStorageService`.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F-7-electron-local-folder-project-mode.md:45:- Checkout is blocked by uncommitted changes: preserve the working tree, keep the current project open and show Git's failure through `dialogService`.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F-7-electron-local-folder-project-mode.md:61:- Push uses the local repository's configured remote and local Git credentials.\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.test.ts:10:import { DEFAULT_COLOR_SCHEME, DEFAULT_MARKDOWN_STYLE_PRESET, MARKDOWN_STYLE_PRESETS } from './theme_config'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.test.ts:23:        expect(result.current.markdownStyleConfig).toEqual(MARKDOWN_STYLE_PRESETS[DEFAULT_MARKDOWN_STYLE_PRESET])\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.test.ts:73:        const customConfig = {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.test.ts:78:        act(() => firstHook.result.current.setCustomMarkdownStyle(customConfig))\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.test.ts:81:        expect(firstHook.result.current.markdownStyleConfig.body.fontSize).toBe('1.2rem')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.test.ts:88:        expect(restoredHook.result.current.markdownStyleConfig.body.fontSize).toBe('1.2rem')\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F-8-signed-windows-electron-package-with-bundled-react-app.md:20:There is no Electron packaging tool or configuration, Windows installer target, application icon, production renderer-loading path, signing configuration, packaging script or packaged-application smoke test. The desktop package can only be started from its source checkout.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F-8-signed-windows-electron-package-with-bundled-react-app.md:27:- Keep development behavior unchanged: an unpackaged Electron process loads the configured Vite URL. A packaged process loads the bundled React entry point and must not use `MD2_APP_URL` as its normal renderer source.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F-8-signed-windows-electron-package-with-bundled-react-app.md:28:- Configure Vite asset paths for packaged loading so JavaScript, CSS, fonts, icons and other assets resolve from the bundled entry point. Direct startup must not produce a blank window or failed `/assets/...` requests.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F-8-signed-windows-electron-package-with-bundled-react-app.md:34:- Enable mandatory signing for release builds so missing, expired or invalid signing configuration fails the build instead of silently producing unsigned artifacts. Use a trusted timestamp service so the signature remains valid after certificate expiry.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F-8-signed-windows-electron-package-with-bundled-react-app.md:61:- The application executable and installer have valid Authenticode signatures from the configured application certificate and include a trusted timestamp.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_001_github_authentication.md:24:- Register a GitHub OAuth app; its `client_id` ships in the app config. Request scopes needed to read/write repo contents (`repo`, or fine-grained contents read/write).\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_001_github_authentication.md:26:- **CORS caveat:** GitHub's device/token endpoints do not send browser CORS headers. Route these two calls through the Electron bridge when connected; for the standalone web app, route them through a minimal CORS-passthrough (config-driven URL). No secret is involved, so this stays backend-free.\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:2:import { DIALOG_SERVICE_EVENT, dialogService, type DialogServiceMessage } from './dialog_service'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:4:describe('dialogService', () => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:7:        dialogService.addEventListener(DIALOG_SERVICE_EVENT, listener)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:9:        const message = dialogService.error(new Error('Save failed'))\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:10:        const expectedDetail = expect.objectContaining({ message: 'Save failed' }) as DialogServiceMessage\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:20:        dialogService.removeEventListener(DIALOG_SERVICE_EVENT, listener)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:25:        dialogService.addEventListener(DIALOG_SERVICE_EVENT, listener)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:27:        dialogService.error(null, { critical: true, fallbackMessage: 'Startup failed', title: 'Startup blocked' })\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:34:        }) as DialogServiceMessage\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:38:        dialogService.removeEventListener(DIALOG_SERVICE_EVENT, listener)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:43:        dialogService.addEventListener(DIALOG_SERVICE_EVENT, listener)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:45:        dialogService.warning('Check settings')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:46:        dialogService.info('Sync started')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:47:        const warningDetail = expect.objectContaining({ message: 'Check settings', severity: 'warning' }) as DialogServiceMessage\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:48:        const infoDetail = expect.objectContaining({ message: 'Sync started', severity: 'info' }) as DialogServiceMessage\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\services\\\\\\\\\\\\\\\\dialog_service.test.ts:53:        dialogService.removeEventListener(DIALOG_SERVICE_EVENT, listener)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:7:    cloneMarkdownStyleConfig,\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:8:    isColorSchemeConfig,\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:9:    isMarkdownStyleConfig,\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:11:    type ColorSchemeConfig,\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:12:    type MarkdownStyleConfig,\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:15:} from './theme_config'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\theme\\\\\\\\\\\\\\\\use_theme_settings.ts:25:    colorScheme: ColorSchemeConfig\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\