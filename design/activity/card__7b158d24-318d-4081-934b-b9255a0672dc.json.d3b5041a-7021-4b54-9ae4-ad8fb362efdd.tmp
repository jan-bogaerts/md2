action_run_registry.ts:156:function upsertAgentEvent(entries: AgentConversationEntry[], event: AgentConversationEventEntry) {\napp\\src\\services\\actions\\action_run_registry.ts:171:function nextConversationSequence(conversation: AgentConversation) {\napp\\src\\services\\actions\\action_run_registry.ts:179:    conversation: AgentConversation,\napp\\src\\services\\actions\\action_run_registry.ts:190:    const entries: AgentConversationEntry[] = currentIndex < 0\napp\\src\\services\\actions\\action_run_registry.ts:206:function conversationStatus(status: ActionRunStatus): AgentConversation['status'] {\napp\\src\\services\\actions\\action_run_registry.node.test.ts:3:import type { AgentConversation, AgentConversationEntry } from '../../data/data_types'\napp\\src\\services\\actions\\action_run_registry.node.test.ts:42:function agentConversation(entries: AgentConversationEntry[], overrides: Partial<AgentConversation> = {}): AgentConversation {\napp\\src\\components\\actions\\action_usage_summary.tsx:2:import type { AgentConversation } from '../../data/data_types'\napp\\src\\components\\actions\\action_usage_summary.tsx:12:    conversations: AgentConversation[]\napp\\src\\components\\actions\\action_usage_summary.test.tsx:3:import type { AgentConversation } from '../../data/data_types'\napp\\src\\components\\actions\\action_usage_summary.test.tsx:7:function conversation(actionId: string, cardInternalId: string, totalTokens: number): AgentConversation {\napp\\src\\components\\actions\\agent_tool_event.tsx:4:import type { AgentConversationEvent } from '../../data/data_types'\napp\\src\\components\\actions\\agent_tool_event.tsx:10:    event: AgentConversationEvent\napp\\src\\components\\actions\\card_run_button.test.tsx:6:import { DEFAULT_CARD_TYPES, type AgentConversation, type AgentConversationEvent, type ProjectCard, type ProjectSnapshot } from '../../data/data_types'\napp\\src\\components\\actions\\card_run_button.test.tsx:29:    status: AgentConversation['status'],\napp\\src\\components\\actions\\card_run_button.test.tsx:30:    events: AgentConversationEvent[] = [],\napp\\src\\components\\actions\\card_run_button.test.tsx:32:): AgentConversation {\napp\\src\\components\\actions\\card_run_button.test.tsx:85:function cardWith(conversations: AgentConversation[]): ProjectCard {\napp\\src\\components\\actions\\card_run_button.test.tsx:435:        vi.spyOn(dataService, 'listAgentConversations').mockResolvedValue([completedConversation])\napp\\src\\components\\actions\\card_run_button.test.tsx:436:        vi.spyOn(dataService, 'loadAgentConversation').mockResolvedValue(completedConversation)\napp\\src\\components\\actions\\card_run_button.test.tsx:445:        expect(dataService.loadAgentConversation).toHaveBeenCalledWith(completedConversation.path)\napp\\src\\components\\actions\\command_execution_event.tsx:4:import type { AgentConversationEvent } from '../../data/data_types'\napp\\src\\components\\actions\\command_execution_event.tsx:10:    event: AgentConversationEvent\napp\\src\\components\\actions\\event_display.ts:1:import type { AgentConversationEvent } from '../../data/data_types'\napp\\src\\components\\actions\\event_display.ts:31:export function eventIdentity(event: AgentConversationEvent) {\napp\\src\\components\\actions\\reasoning_event.tsx:2:import type { AgentConversationEvent } from '../../data/data_types'\napp\\src\\components\\actions\\reasoning_event.tsx:6:    event: AgentConversationEvent\n",
