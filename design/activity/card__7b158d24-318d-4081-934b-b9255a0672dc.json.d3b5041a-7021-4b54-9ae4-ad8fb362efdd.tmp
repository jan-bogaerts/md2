_git_service.test.mjs:540:        const config = { pushMode: 'manual', workingFolder: 'design' };\\\\\\\\ndesktop\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\git\\\\\\\\\\\\\\\\local_git_service.test.mjs:544:            await writeFile(join(rootPath, 'md2.config.json'), `${JSON.stringify(config, null, 2)}\\\\\\\\\\\\\\\\n`);\\\\\\\\ndesktop\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\git\\\\\\\\\\\\\\\\local_git_service.test.mjs:545:            await execFileAsync('git', ['add', 'md2.config.json'], { cwd: rootPath });\\\\\\\\ndesktop\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\git\\\\\\\\\\\\\\\\local_git_service.test.mjs:546:            await execFileAsync('git', ['commit', '-m', 'Seed config'], { cwd: rootPath });\\\\\\\\ndesktop\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\git\\\\\\\\\\\\\\\\local_git_service.test.mjs:548:            await saveProjectConfig({ branch: 'main', id: 'local', rootPath }, config);\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_values_not_typed_per_key.md:3:title: config values are not typed per key, forcing casts at every consumer\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_values_not_typed_per_key.md:14:`ConfigValues` is declared as `Record<ConfigKey, ConfigValue>` where `ConfigValue = boolean | number | string | AgentProfile[] | CardTypeConfig[]` (`app/src/services/config_service_core.ts`). Every read therefore returns the full union, and consumers narrow with `as` casts: `useConfigValue('desktop.agent') as string` (`app_menu.tsx`), `as AgentProfile[]`/`as string` in `action_popup_content.tsx` and `config_value_editor.tsx`, etc. This already caused real breakage: the 2026-07-07 audit found `npm run typecheck` failing on four `ConfigValue`-mismatch errors in the action popup (fixed with casts, matching the existing idiom — but the idiom is the bug). Casts silently go stale when an entry's type changes; the compiler can't catch a `desktop.agent` entry becoming a profile object, and every new consumer must know the runtime type by convention.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_values_not_typed_per_key.md:19:  interface ConfigValueTypes {\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_values_not_typed_per_key.md:23:      'project.cardTypes': CardTypeConfig[]\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_values_not_typed_per_key.md:25:      // … one line per ConfigKey\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_values_not_typed_per_key.md:27:  type ConfigKey = keyof ConfigValueTypes\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_values_not_typed_per_key.md:28:  type ConfigValues = ConfigValueTypes\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_values_not_typed_per_key.md:30:- Type `configService.get<K extends ConfigKey>(key: K): ConfigValueTypes[K]` and `set(key, value: ConfigValueTypes[K])`; `useConfigValue`/`useConfigValueOrFallback` already generic — they start returning the narrow type for free.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_values_not_typed_per_key.md:31:- Remove the now-redundant `as string` / `as AgentProfile[]` casts at consumers (`app_menu.tsx`, `action_popup_content.tsx`, `config_value_editor.tsx`, `github_auth_service`, commit batcher delay, …).\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_values_not_typed_per_key.md:32:- Keep `ConfigValue` as the union only where genuinely heterogeneous handling is needed (the generic config-page editor, validation dispatch).\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_values_not_typed_per_key.md:35:- `configService.get('desktop.agent')` is typed `string` and `get('desktop.agentProfiles')` is typed `AgentProfile[]` without casts.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_v