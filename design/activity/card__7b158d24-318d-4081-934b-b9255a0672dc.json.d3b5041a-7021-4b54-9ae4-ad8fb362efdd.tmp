napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:274:        expect(restoredDialog.style.height).toBe('360px')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:280:        Object.defineProperty(window, 'innerWidth', { configurable: true, value: 1200, writable: true })\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:295:        const dialog = screen.getByRole('dialog', { name: 'Test popper' })\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:296:        dialog.getBoundingClientRect = vi.fn(() => new DOMRect(900, 100, 400, 300))\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:314:        expect(dialog.style.height).toBe('100vh')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:315:        expect(dialog.style.left).toBe('800px')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:322:        expect(dialog.style.left).toBe('200px')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:326:        Object.defineProperty(window, 'innerWidth', { configurable: true, value: 1200, writable: true })\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:328:        const dialog = screen.getByRole('dialog', { name: 'Expandable popper' })\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:329:        dialog.getBoundingClientRect = vi.fn(() => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:330:            const left = dialog.style.position === 'fixed' ? Number.parseFloat(dialog.style.left) : 700\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:336:        expect(dialog.style.left).toBe('700px')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:339:        expect(dialog).not.toHaveAttribute('data-full-height')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:340:        expect(dialog.style.left).toBe('')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:341:        expect(dialog.style.height).toBe('300px')\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_013_action_runner_dependency_surface.md:15:Current React `ActionRunner` injects bridge, project, history, agent callbacks, command execution, and configuration. Scheduled Electron execution has a different dependency set. Moving to one Electron runner needs one explicit dependency boundary, not two runner-shaped service graphs.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_013_action_runner_dependency_surface.md:23:  - action environment: project, actions folder, supported agent configuration and worktree preparation.\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\text_view\\\\\\\\\\\\\\\\list_editor_toolbar_controls.tsx:5:import type { AgentConversation, CardTypeConfig } from '../../data/data_types'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\text_view\\\\\\\\\\\\\\\\list_editor_toolbar_controls.tsx:21:    cardTypes: CardTypeConfig[]\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\text_view\\\\\\\\\\\\\\\\list_editor_toolbar_controls.tsx:96:                    aria-haspopup=\\\\\\\\\\\\\\\"dialog\\\\\\\\\\\\\\\"\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\text_view\\\\\\\\\\\\\\\\card_properties_popover.test.tsx:19:        expect(screen.getByRole('dialog', { name: 'Card properties popup' })).toHaveTextContent('Properties content')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.test.tsx:48:    it('closes the GitHub account dialog without starting an auth action', async () => {\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_009_split_config_service.md:3:title: split config service into entries, persistence and service\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_009_split_config_service.md:14:Item 6 of J-002. `app/src/services/config_service.ts` is ~543 lines mixing the static entry metadata table, scope persistence and the service logic. Extract the table and the persistence adapters so `ConfigService` keeps merge, draft lifecycle, validation and events. Pure refactor — **no behavior change**.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_009_split_config_service.md:16:Depends on: J-003 (the `config_entries.ts` re-export and unused `config_persistence.ts` duplicate deleted, module back at `config_service.ts`) — this task recreates those filenames by **moving** the inline definitions.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_009_split_config_service.md:19:- `services/config_entries.ts` — the static entry metadata table (keys, sections, labels, types, defaults, scopes), exported as data.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_009_split_config_service.md:20:- `services/config_persistence.ts` — localStorage read/write for react/connection scopes and the desktop-bridge read/write adapter.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_009_split_config_service.md:21:- `ConfigService` imports both; no inline copies of the moved table/functions remain (the first attempt kept them inline with dead duplicates on disk).\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_009_split_config_service.md:23:- Coordinate with B-036 (per-key config value typing): if B-036 lands first, the `ConfigValueTypes` map lives in `config_entries.ts`; if this lands first, leave an obvious home for it there.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_009_split_config_service.md:26:- `config_service.ts` is under ~300 lines and contains no entry-metadata literals or storage read/write internals.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_009_split_config_service.md:27:- The entry table is importable as plain data; persistence adapters are unit-testable without a `ConfigService` instance.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_009_split_config_service.md:28:- `ConfigService` public API unchanged; existing tests pass unmodified except for import paths.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_009_split_config_service.md:33:- `design\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\B_036_config_values_not_typed_per_key.md`\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_017_markdown_editor_data_sources.md:55:**Hoisted list editor** — `TextView` owns one `MarkdownEditor`, reused for card bodies, action prompts, and action phrases. Action config travels up through `MarkdownDocumentOwnerConfig`, mutable maps, and mirrored React state; card content travels from the project snapshot through props and writes back through `ProjectWorkspace`. The editor is uncontrolled while typing, so it reverse-engineers document switches from `documentId`/`markdown` prop changes, and keeps a synthetic empty document mounted when nothing is active.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_017_markdown_editor_data_sources.md:226:**Props mode** — only for transient local buffers (`new_card_dialog`, `action_agent_form`). `markdown` is mount-time initial content; external replacement still goes through `MarkdownEditorHandle.setMarkdown()`.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_017_markdown_editor_data_sources.md:234:List view has two lifetime-stable editor surfaces: `CardEditor` owns the `list-card` editor/store, `ActionEditor` owns the `list-action` editor/store. Both mount for the full `TextView` lifetime and toggle with `hidden` — switching list tabs never mounts/unmounts either. Remove `key={activeAction.id}` and all hoisted owner configuration/maps.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_017_markdown_editor_data_sources.md:270:`ProjectWorkspace` passes an explicit `visible` prop to both views. A view becoming hidden closes/resets all transient UI it owns. Every portaled surface also gates `open` with `visible` (MUI portals render outside the hidden subtree) — applies to: board card-body popover and its delete dialog, affects dialog, list card-properties popover, list agent popup, drag overlay/active drag state.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_017_markdown_editor_data_sources.md:291:| `new_card_dialog.tsx` | Keep props mode |\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_017_markdown_editor_data_sources.md:296:Delete `MarkdownDocumentConfig`, `MarkdownDocumentOwnerConfig`, action Markdown owner maps, synthetic empty document, and hoisted Markdown change/edit handlers once no call sites remain.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_017_markdown_editor_data_sources.md:305:- Report failures through `dialogService.error` with the same operation/path context current callers use.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_017_markdown_editor_data_sources.md:331:- Synchronous data-source write failure surfaces via `dialogService`, leaves the editor dirty, and doesn't block other editors from flushing.\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:1:import { Avatar, Button, Dialog, DialogActions, DialogContent, IconButton, Tooltip } from '@mui/material'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:21:    const [isDialogOpen, setIsDialogOpen] = useState(false)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:23:    const handleOpenDialog = () => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:24:        setIsDialogOpen(true)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:27:    const handleCloseDialog = () => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:28:        setIsDialogOpen(false)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:36:                <IconButton aria-label=\\\\\\\\\\\\\\\"GitHub account\\\\\\\\\\\\\\\" onClick={handleOpenDialog} size=\\\\\\\\\\\\\\\"small\\\\\\\\\\\\\\\" sx={{ height: 34, width: 34 }}>\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:48:            <Dialog fullWidth maxWidth=\\\\\\\\\\\\\\\"sm\\\\\\\\\\\\\\\" onClose={handleCloseDialog} open={isDialogOpen}>\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:49:                <DialogContent>\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:51:                </DialogContent>\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:52:                <DialogActions>\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:53:                    <Button onClick={handleCloseDialog}>Close</Button>\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:54:                </DialogActions>\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\github_auth_toolbar_button.tsx:55:            </Dialog>\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_018_extract_project_persistence_coordinator.md:154:- If action draft serialization schedules a file and card flush then fails, pending state remains dirty and the error reaches the existing caller/dialog path.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_015_split_github_storage_service.md:14:`app/src/services/github_storage_service.ts` is 855 lines — the last module of its size left after the J-002/J-004..J-014 splits brought everything else to roughly 400 lines or under. It currently bundles several concerns behind one class: authenticated fetch plumbing and error mapping, repository/branch listing, tree and blob traversal for project loading, file save/move/delete with commit batching semantics, manual push handling, and project-config read/write. Changes to any one concern force readers through all of them, and the test file mirrors the same sprawl.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_015_split_github_storage_service.md:21:- project-config IO.\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_016_split_action_runner_service.md:30:- `agentConfigProvider`;\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_016_split_action_runner_service.md:155:Add one `ActionAgentExecutor` class in its own file. A class is justified because it owns several related operations and injected dependencies (`agentConfigProvider`, `agentRunnerService`, `localGitService`). It owns:\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_016_split_action_runner_service.md:157:- resolved agent configuration;\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_016_split_action_runner_service.md:312:| `agentConfigProvider` | Used for definition validation and runtime agent resolution | Keep both reads; do not cache configuration across executions unless existing behavior proves it safe. |\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\main_window.tsx:5:import { ConfigPage } from '../config/config_page'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\main_window.tsx:26:    const isConfigPage = location.pathname === '/config'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\main_window.tsx:40:    const handleOpenConfig = useCallback(() => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\main_window.tsx:41:        navigateTo('/config')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\main_window.tsx:52:                onOpenConfig={handleOpenConfig}\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\main_window.tsx:56:            {isConfigPage ? (\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\main_window.tsx:57:                <ConfigPage hash={location.hash} />\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\main_window.tsx:66:            {!isConfigPage && !isMobile ? <StatusBar /> : null}\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\main_window.test.tsx:7:import { configService } from '../../services/config/config_service'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\shell\\\\\\\\\\\\\\\\main_window.test.tsx:15:import { DialogDisplay } from '../dialog_display'\\\\\\\\napp\\\\\\\\\\\\\\\\s