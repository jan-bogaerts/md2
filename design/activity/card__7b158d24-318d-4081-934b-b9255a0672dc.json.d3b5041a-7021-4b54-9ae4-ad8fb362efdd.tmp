_split_local_git_service.md:20:- `desktop/project_files.js` — load project/root/config, read/write/delete/move files, working-folder template, watchProject.\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.tsx:119:/** A non-modal anchored surface with configurable drag handles for resizing its content. */\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.tsx:285:                role=\\\\\\\\\\\\\\\"dialog\\\\\\\\\\\\\\\"\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_003_refactor_cleanup_dead_files_and_shims.md:25:- `app/src/services/config_persistence.ts`\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_003_refactor_cleanup_dead_files_and_shims.md:26:- `app/src/services/config_entries.ts` (pure re-export)\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_003_refactor_cleanup_dead_files_and_shims.md:38:- `app/src/services/config_service.ts` (shim) ← `config_service_core.ts`\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\text_view\\\\\\\\\\\\\\\\file_tree_toolbar.tsx:6:import type { CreateTreeItemKind } from './create_tree_item_dialog'\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_76_action_streaming_or_oneshot_agent_mode.md:13:- `start()` spawns the CLI with the prompt as the **last argv element** (`argumentsList = [...configuredArguments, prompt]`).\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\text_view\\\\\\\\\\\\\\\\card_properties_popover.tsx:24:                    role: 'dialog',\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:3:import { dialogService } from '../services/dialog_service'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:5:import { DialogDisplay } from './dialog_display'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:9:describe('DialogDisplay', () => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:17:        render(<DialogDisplay />)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:20:            dialogService.error('Save failed')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:26:        expect(screen.queryByRole('dialog')).toBeNull()\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:31:        render(<DialogDisplay />)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:34:            dialogService.error('Save failed')\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:50:    it('shows critical errors as a blocking dialog', async () => {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:51:        render(<DialogDisplay />)\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:54:            dialogService.error('Startup failed', { critical: true, title: 'Startup blocked' })\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:57:        expect(await screen.findByRole('dialog', { name: 'Startup blocked' })).toBeInTheDocument()\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:64:        expect(screen.queryByRole('dialog', { name: 'Startup blocked' })).toBeNull()\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\dialog_display.test.tsx:68:        render(<DialogDisplay />)\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_002_refactor_large_modules.md:26:- **J-004** — extract the four project toolbar menu dialogs (rest of item 1).\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_002_refactor_large_modules.md:31:- **J-009** — split `config_service.ts` into entries + persistence + service (item 6).\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_002_refactor_large_modules.md:46:- `design\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_004_split_project_toolbar_menu_dialogs.md`\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_002_refactor_large_modules.md:51:- `design\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\J_009_split_config_service.md`\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\text_view\\\\\\\\\\\\\\\\tab_bar.tsx:10:import type { CardTypeConfig, ProjectCard } from '../../data/data_types'\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\text_view\\\\\\\\\\\\\\\\tab_bar.tsx:30:    cardTypes: CardTypeConfig[]\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\text_view\\\\\\\\\\\\\\\\tab_bar.tsx:33:function cardTypeColor(card: ProjectCard, cardTypes: CardTypeConfig[]) {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\text_view\\\\\\\\\\\\\\\\tab_bar.tsx:54:function tabData(cardTypes: CardTypeConfig[], actionsFolder: string, document: OpenDocument): OpenTab {\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popover.tsx:87:/** An anchored popover with configurable drag handles for resizing its content. */\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popover.tsx:165:                    role: 'dialog',\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_69_config_in_dialog.md:5:title: Config in dialog\\\\\\\\ndesign\\\\\\\\\\\\\\\\feature_descriptions\\\\\\\\\\\\\\\\F_69_config_in_dialog.md:15:Show config in dialog instead of page. Keep ability to navigate with url when in browser\\\\\\\\napp\\\\\\\\\\\\\\\\src\\\\\\\\\\\\\\\\components\\\\\\\\\\\\\\\\resizable_popper.test.tsx:53:        ex