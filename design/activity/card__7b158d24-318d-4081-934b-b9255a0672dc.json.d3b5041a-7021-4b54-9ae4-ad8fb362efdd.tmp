          "content": "shared/card_activity.mjs:127:function parseConversation(value, index, activityOrigin) {\napp/src/services/data/data_service.ts:251:            cardPathChanged: (fromPath, toPath) => this.dispatchCardPathChanged(fromPath, toPath),\napp/src/services/data/data_service.ts:342:    private dispatchCardPathChanged(fromPath: string, toPath: string) {\napp/src/components/text_view/list_editor_toolbar_controls.tsx:34:    useEffect(() => {\napp/src/components/text_view/list_editor_toolbar_controls.tsx:42:    useEffect(() => {\napp/src/data/data_types.ts:245:export interface AgentConversationMessage {\napp/src/data/data_types.ts:262:export interface AgentConversationEvent {\napp/src/data/data_types.ts:280:export interface AgentConversationMessageEntry extends AgentConversationMessage {\napp/src/data/data_types.ts:284:export interface AgentConversationEventEntry extends AgentConversationEvent {\napp/src/data/data_types.ts:299:export interface AgentConversation {\napp/src/data/data_types.ts:315:export interface AgentConversationError {\napp/src/components/actions/action_conversation_chat.tsx:49:    useEffect(() => {\napp/src/components/actions/action_popup.tsx:29:    projectKey?: string\napp/src/components/actions/action_popup.tsx:57:    const projectKey = props.projectKey ?? (project ? `${project.id}:${project.branch}` : null)\napp/src/components/actions/action_popup.tsx:93:            projectKey={projectKey}\napp/src/services/actions/card_action_popup_service.ts:13:    projectKey: string\napp/src/services/actions/card_action_popup_service.ts:16:function projectKey(service: DataService) {\napp/src/services/actions/card_action_popup_service.ts:42:export class CardActionPopupService extends EventTarget {\napp/src/services/actions/card_action_popup_service.ts:51:        this.currentProjectKey = projectKey(this.dataService)\napp/src/services/actions/card_action_popup_service.ts:74:            projectKey: activeProjectKey,\napp/src/services/actions/card_action_popup_service.ts:88:    activate(id: string) {\napp/src/services/actions/card_action_popup_service.ts:104:        const nextProjectKey = projectKey(this.dataService)\ndesktop/src/actions/agent/agent_conversation.js:53:function createConversation(request, id, startedAt, reference) {\ndesktop/src/actions/activity/activity_files.js:56:function queueActivityUpdate(filePath, update) {\ndesktop/src/actions/activity/activity_files.js:119:function upsertConversation(activity, conversation) {\napp/src/components/actions/action_conversation_store.ts:80:    configureInitialSelection(path: string | null) {\ndesktop/src/actions/agent/agent_runner_service.js:16:    persistConversationCheckpoint,\ndesktop/src/actions/agent/agent_runner_service.js:308:        this.persistConversationCheckpoint = dependencies.persistConversationCheckpoint\ndesktop/src/actions/agent/agent_runner_service.js:309:            ?? persistConversationCheckpoint;\ndesktop/src/actions/agent/agent_runner_service.js:948:        if (event.type === 'approval') {\ndesktop/src/actions/agent/agent_runner_service.js:1154:        const write = run.persistence.then(() => this.persistConversationCheckpoint(snapshot));\n",
          "id": "agent-turn-625d27fc-5272-49cb-ae58-8ed982a826f6-provider-230",
