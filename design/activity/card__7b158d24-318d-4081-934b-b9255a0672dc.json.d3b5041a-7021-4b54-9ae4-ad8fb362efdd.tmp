08:    async closeWaitingActionConversation(\napp\\src\\services\\data\\remote_control_storage_service.ts:412:        return this.request<AgentConversation>('closeWaitingActionConversation', [reference, status])\napp\\src\\services\\data\\markdown_parsing_service.node.test.ts:372:    it('serializes policy booleans as canonical strings', () => {\napp\\src\\services\\data\\remote_control_storage_service.node.test.ts:365:            service.closeWaitingActionConversation('activity.json#conversation=one', 'completed'),\napp\\src\\services\\data\\remote_control_storage_service.node.test.ts:379:            { method: 'closeWaitingActionConversation', params: ['activity.json#conversation=one', 'completed'] },\napp\\src\\services\\data\\markdown_parsing_service.ts:28:    /** Activity conversation references serialized through the existing `agents` frontmatter field. */\napp\\src\\services\\data\\markdown_parsing_service.ts:319:function serializeNewHeader(header: NewCardHeader) {\napp\\src\\services\\data\\markdown_parsing_service.ts:477:        return `${HEADER_DELIMITER}\\n${serializeNewHeader(header)}\\n${HEADER_DELIMITER}\\n\\n${body}`\napp\\src\\components\\actions\\action_editor.test.tsx:334:        const serialize = vi.spyOn(actionServiceModule, 'serializeActionDefinition')\napp\\src\\components\\actions\\action_editor.test.tsx:342:        expect(serialize).not.toHaveBeenCalled()\napp\\src\\components\\actions\\action_editor.test.tsx:353:        expect(serialize).not.toHaveBeenCalled()\napp\\src\\components\\actions\\action_popup_defaults.ts:119:    if (!bridge?.closeWaitingActionConversation) throw new Error('Closing a waiting conversation requires Electron')\napp\\src\\components\\actions\\action_popup_defaults.ts:121:    return bridge.closeWaitingActionConversation(reference, status)\napp\\src\\components\\actions\\action_popup_bottom_row.test.tsx:127:        const closeWaitingActionConversation = vi.fn(async () => updated)\napp\\src\\components\\actions\\action_popup_bottom_row.test.tsx:129:            closeWaitingActionConversation,\napp\\src\\components\\actions\\action_popup_bottom_row.test.tsx:145:        await vi.waitFor(() => expect(closeWaitingActionConversation).toHaveBeenCalledWith(source.path, scenario.status))\napp\\src\\components\\actions\\action_popup_bottom_row.test.tsx:158:            closeWaitingActionConversation: vi.fn(async () => { throw staleError }),\n",
          "providerItemId": "exec-eb1d6428-4511-4f01-9584-bb1c2d6e955a",
          "sequence": 47,
          "status": "completed",
